# --- RPC sağlayıcıları ----------------------------------------------------
# Format: <url>|<saniyedeki_istek_limiti>  (birden fazlası virgülle ayrılır)
# Boş bırakılırsa public RPC kullanılır (yavaş, sık sık 429 verir).
# Örnek:
# RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=SENIN_ANAHTARIN|10,https://solana-mainnet.g.alchemy.com/v2/SENIN_ANAHTARIN|25
RPC_ENDPOINTS=

# --- Cache --------------------------------------------------------------
# Render ücretsiz katmanında disk kalıcı değil; /tmp her zaman yazılabilir.
CACHE_PATH=/tmp/scans.db
CACHE_TTL=900

# --- API ---------------------------------------------------------------
RATE_LIMIT_PER_MIN=10
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Tarama eşiği ve karne --------------------------------------------
# Bu market cap'in (USD) altındaki tokenlar hiç taranmaz.
MIN_MARKET_CAP_USD=10000
# Tarama sonrası market cap kaç saniye izlensin (varsayılan 30 dk).
TRACK_WINDOW_SEC=1800
# Pencerede en düşük noktaya göre bu oranı geçen düşüş "çöktü" sayılır.
TRACK_DROP_PCT=0.35
# İzlenen tokenların market cap'i kaç saniyede bir yenilensin.
TRACK_POLL_SEC=120

# Arayüz backend ile aynı serviste sunulduğu için genelde gerekmez.
# FRONTEND_DIR=/opt/render/project/src/frontend
