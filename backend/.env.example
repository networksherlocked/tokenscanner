# --- RPC sağlayıcıları ----------------------------------------------------
# Format: <url>|<saniyedeki_istek_limiti>  (birden fazlası virgülle ayrılır)
# Boş bırakılırsa public RPC kullanılır (yavaş, sık sık 429 verir).
# Örnek:
# RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=SENIN_ANAHTARIN|10,https://solana-mainnet.g.alchemy.com/v2/SENIN_ANAHTARIN|25
RPC_ENDPOINTS=

# --- Depo --------------------------------------------------------------
# DATABASE_URL boşsa SQLite kullanılır (yerel geliştirme). Render'da /tmp
# kalıcı değil — karne/itiraz verisi her yeniden başlatmada sıfırlanır.
# Kalıcı olması için Supabase Postgres bağlantı dizesini gir:
#   Supabase > Project Settings > Database > Connection string > URI
#   (Transaction pooler / port 6543 önerilir, ?sslmode=require ekli)
# DATABASE_URL=postgresql://postgres.xxxx:PAROLA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
CACHE_PATH=/tmp/scans.db
CACHE_TTL=900

# --- API ---------------------------------------------------------------
RATE_LIMIT_PER_MIN=10
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Tarama eşiği ve karne --------------------------------------------
# Bu market cap'in (USD) altındaki tokenlar hiç taranmaz.
MIN_MARKET_CAP_USD=10000
# Tarama sonrası market cap kaç saniye izlensin (varsayılan 24 saat).
TRACK_WINDOW_SEC=86400
# Pencerede en düşük noktaya göre bu oranı geçen düşüş "çöktü" sayılır.
TRACK_DROP_PCT=0.35
# İzlenen tokenların market cap'i kaç saniyede bir yenilensin (varsayılan 5 dk).
TRACK_POLL_SEC=300

# Arayüz backend ile aynı serviste sunulduğu için genelde gerekmez.
# FRONTEND_DIR=/opt/render/project/src/frontend
