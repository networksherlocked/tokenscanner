# --- RPC sağlayıcıları ----------------------------------------------------
# Format: <url>|<saniyedeki_istek_limiti>  (birden fazlası virgülle ayrılır)
# Boş bırakılırsa public RPC kullanılır (yavaş, sık sık 429 verir).
# Örnek:
# RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=SENIN_ANAHTARIN|10,https://solana-mainnet.g.alchemy.com/v2/SENIN_ANAHTARIN|25
# NOT: Bu değer başlangıç varsayılanıdır. Admin panel → Ayarlar → "RPC uç
# noktaları"ndan canlı değiştirilebilir (DB'ye yazılır, havuz anında
# yeniden yapılandırılır, yeniden dağıtım gerekmez).
RPC_ENDPOINTS=

# --- Depo --------------------------------------------------------------
# DATABASE_URL boşsa SQLite kullanılır (yerel geliştirme). Render'da /tmp
# kalıcı değil — karne/itiraz verisi her yeniden başlatmada sıfırlanır.
# Kalıcı olması için Supabase Postgres bağlantı dizesini gir:
#   Supabase > Project Settings > Database > Connection string > URI
#   (Transaction pooler / port 6543 önerilir, ?sslmode=require ekli)
# DATABASE_URL=postgresql://postgres.xxxx:PAROLA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
CACHE_PATH=/tmp/scans.db
# Tarama sonucu kaç saniye önbellekte tutulur (başlangıç varsayılanı).
# Admin panel → Genel → "Önbellek süresi" ile canlı değiştirilebilir; DB'deki
# değer bunu ezer.
CACHE_TTL=900

# "Yenile" butonu: aynı token için iki canlı yeniden tarama arası minimum
# saniye. 0 = sınırsız. Admin panel → Ayarlar → "Yenile butonu aralığı" ile
# canlı değiştirilebilir; DB'deki değer (refresh_cooldown_sec) bunu ezer.
REFRESH_COOLDOWN_SEC=3600

# --- API ---------------------------------------------------------------
RATE_LIMIT_PER_MIN=10
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Admin paneli (/admin) -------------------------------------------
# Boşsa panel tamamen kapalı (404). Uzun ve rastgele bir değer ver:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Panelden "Şifre değiştir" ile DB'ye yeni bir değer yazılırsa o geçerli olur.
ADMIN_TOKEN=
# RPC sağlayıcının aylık sorgu kotası (Helius free = 1000000). 0 = bilinmiyor.
# Admin panelinde "kalan sorgu" göstermek için (instance başından sayar).
RPC_MONTHLY_QUOTA=0

# --- Tarama eşiği ve karne --------------------------------------------
# Bu market cap'in (USD) altındaki tokenlar hiç taranmaz.
MIN_MARKET_CAP_USD=10000
# Tarama sonrası market cap kaç saniye izlensin (varsayılan 24 saat).
TRACK_WINDOW_SEC=86400
# Pencerede en düşük noktaya göre bu oranı geçen düşüş "çöktü" sayılır.
TRACK_DROP_PCT=0.35
# İzlenen tokenların market cap'i kaç saniyede bir yenilensin (varsayılan 5 dk).
TRACK_POLL_SEC=300

# --- Motor ayarları ----------------------------------------------------
# Fonlama ağacı kaç hop geriye izlensin (hop 1 = direkt fonlayıcı). 3 = A→B→C
# dallanma; her ekstra hop ~+15-25 RPC çağrısı. Bütçe darsa 2 yap.
FUNDING_TREE_HOPS=3
FUNDING_TREE_MAX_PER_HOP=14

# --- Eski / yüksek hacimli token lansman verisi (opsiyonel) -----------
# Bonding curve / pair imza taraması başlangıcı göremezse (çok eski Raydium
# native pool) ilk trade'ler bir indeksleyiciden çekilir. Anahtar boşsa bu
# adım atlanır ve motor "yalnızca mevcut yapı" moduna düşer.
EARLY_TRADES_PROVIDER=birdeye
EARLY_TRADES_MAX=60
# https://birdeye.so → Dashboard → API. Ücretsiz katman ~30k istek/ay.
BIRDEYE_API_KEY=
# BIRDEYE_BASE=https://public-api.birdeye.so

# --- X (Twitter) otomatik paylaşım (opsiyonel) -----------------------
# Tarama sonuçlarını otomatik tweet'ler. Anahtarlar + aç/kapa + eşikler
# admin panel → Ayarlar → "X otomatik paylaşım"dan da girilebilir (DB, canlı).
# X Developer Portal → App (Read and write izinli) → Keys and tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Tweet'lerdeki linkler için servisin herkese açık adresi:
PUBLIC_BASE_URL=

# --- Öğrenme -------------------------------------------------------------
# "organic/inconclusive" denip sonradan sert çöken tokenlarda koordinasyon
# izi varsa o cüzdanları/deployer'ı otomatik işaretle (sonraki taramalarda kullanılır).
LEARN_ENABLED=1
LEARN_MIN_DROP=0.55        # sadece bu orandan sert çöküşlerden ders çıkar
LEARN_MAX_WALLETS=12       # bir dersten en fazla kaç cüzdan işaretlensin

# Arayüz backend ile aynı serviste sunulduğu için genelde gerekmez.
# FRONTEND_DIR=/opt/render/project/src/frontend
